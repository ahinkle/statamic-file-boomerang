{
    "name": "ahinkle/statamic-file-boomerang",
    "description": "Git automation for Statamic on hosts without a persistent disk.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "git",
        "laravel-cloud"
    ],
    "authors": [
        {
            "name": "Andy Hinkle"
        }
    ],
    "require": {
        "php": "^8.3",
        "league/flysystem-aws-s3-v3": "^3.0",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Ahinkle\\FileBoomerang\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ahinkle\\FileBoomerang\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "File Boomerang",
            "slug": "file-boomerang",
            "description": "Git automation for Statamic on hosts without a persistent disk."
        },
        "laravel": {
            "providers": [
                "Ahinkle\\FileBoomerang\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
